<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2C353D"
        android:paddingRight="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="30dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/back_butt"
            android:contentDescription="Назад"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить устройство"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название устройства"
            android:textStyle="bold"
            android:background="@android:drawable/edit_text"
            android:padding="12dp" />

        <EditText
            android:id="@+id/editDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Идентификатор устройства"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:textStyle="bold"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выбрать устройство"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#94949B"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:columnOrderPreserved="false">

                <!-- Свет -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLight"
                        android:drawableTop="@drawable/light_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#0B50A0"
                        app:strokeColor="#A8BDDB"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Свет"
                        android:textColor="#0B50A0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Кондиционер -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAC"
                        android:drawableTop="@drawable/condi_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#CCCCCC"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Кондиционер"
                        android:textColor="#94949B"
                        android:textSize="16sp"
                        android:textStyle="bold"

                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Вытяжка -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHood"
                        android:drawableTop="@drawable/hood_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#CCCCCC"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Вытяжка"
                        android:textColor="#94949B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Температура -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemp"
                        android:drawableTop="@drawable/thermo_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#94949B"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Температура"
                        android:textColor="#94949B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Вентилятор -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFan"
                        android:drawableTop="@drawable/fan_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#CCCCCC"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Вентилятор"
                        android:textColor="#94949B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

            </GridLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveAddress"
        android:layout_width="170dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="#0D47A1"
        android:text="Сохранить"
        android:textColor="#FFFFFF"
        app:cornerRadius="10dp"
        android:textSize="18sp"
        android:layout_margin="20dp" />

</LinearLayout>