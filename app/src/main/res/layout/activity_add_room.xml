<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2C353D"

        android:paddingRight="16dp"
        android:paddingLeft="16dp"
        android:paddingTop="30dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/back_butt"
            android:contentDescription="Назад"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить комнату"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название комнаты"
            android:textStyle="bold"
            android:background="@android:drawable/edit_text"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выбрать комнату"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#94949B"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:columnOrderPreserved="false">

                <!-- Гостиная -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLiving"
                        android:drawableTop="@drawable/living_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#0B50A0"
                        app:strokeColor="#A8BDDB"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Гостиная"
                        android:textColor="#0B50A0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Кухня -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKitchen"
                        android:drawableTop="@drawable/kitchen_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#CCCCCC"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Кухня"
                        android:textColor="#94949B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Ванная -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBathroom"
                        android:drawableTop="@drawable/bathroom_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#CCCCCC"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ванная"
                        android:textColor="#94949B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Кабинет -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudy"
                        android:drawableTop="@drawable/office_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#CCCCCC"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Кабинет"
                        android:textColor="#94949B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Спальня -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBedroom"
                        android:drawableTop="@drawable/bed_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#CCCCCC"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Спальня"
                        android:textColor="#94949B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Зал -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_margin="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHall"
                        android:drawableTop="@drawable/tv_white1"
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:text=""
                        app:backgroundTint="#94949B"
                        app:strokeColor="#CCCCCC"
                        app:strokeWidth="1dp"
                        app:cornerRadius="100dp"
                        android:paddingTop="20dp"
                        android:drawablePadding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Зал"
                        android:textColor="#94949B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

            </GridLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveRoom"
        android:layout_width="170dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="#0D47A1"
        android:text="Сохранить"
        android:textColor="#FFFFFF"
        app:cornerRadius="10dp"
        android:textSize="18sp"
        android:layout_margin="20dp" />

</LinearLayout>